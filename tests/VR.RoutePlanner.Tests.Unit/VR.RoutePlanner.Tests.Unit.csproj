<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VR.RoutePlanner.Domain\VR.RoutePlanner.Domain.csproj" />
    <ProjectReference Include="..\..\src\VR.RoutePlanner.Application\VR.RoutePlanner.Application.csproj" />
    <ProjectReference Include="..\..\src\VR.RoutePlanner.Infrastructure\VR.RoutePlanner.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\VR.RoutePlanner.Workers\VR.RoutePlanner.Workers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Образец сообщения state, снятый с робота: копия байт-в-байт из docs/contracts. -->
    <None Include="..\..\docs\contracts\samples\mqtt-state.json" Link="Robots\Assets\mqtt-state-robot.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Второй образец state версии 2.0.0 из план-набора этапа 2.5 (копия байт-в-байт). -->
    <None Include="Robots\Assets\vda-state-after.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Образец заказа с робота: копия байт-в-байт из план-набора этапа 2.5. -->
    <None Include="Robots\Assets\vda-order.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
